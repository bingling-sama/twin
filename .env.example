# Twin — Image Similarity Search Configuration Template
# Copy this file to .env and adjust as needed.

# --- Model ---
# Model type: "clip" or "dinov2"
TWIN_MODEL_TYPE=clip
# CLIP model variant: ViT-B-32, ViT-B-16, ViT-L-14, etc.
TWIN_MODEL_NAME=ViT-B-32
# DINOv2 model variant (used when TWIN_MODEL_TYPE=dinov2 or dinov2 is in model name):
# vit_small_patch14_dinov2, vit_base_patch14_dinov2, vit_large_patch14_dinov2
TWIN_DINOV2_MODEL_NAME=vit_small_patch14_dinov2
# Pretrained weights for CLIP: openai, laion2b_s34b_b79k, etc.
TWIN_PRETRAINED=openai
# Device: cuda, mps, cpu, or empty for auto-detect
TWIN_DEVICE=

# --- Faiss ---
# Directory for index and metadata persistence
TWIN_INDEX_PATH=data
# Source images directory (auto-synced on startup or batch index source)
TWIN_IMAGES_DIR=data/images
# Faiss index type: "flat" | "ivf_flat" | "ivf_pq" | "hnsw"
TWIN_FAISS_INDEX_TYPE=ivf_flat
# IVF centroids; 0 = auto (4 * sqrt(N))
TWIN_FAISS_NLIST=0
# IVF search-time probe count (higher = higher recall, lower speed)
TWIN_FAISS_NPROBE=16
# Auto-convert Flat -> IVF when indexed vector count >= 256
TWIN_FAISS_AUTO_UPGRADE=true
# Enable GPU acceleration for Faiss if CUDA and faiss-gpu are available
TWIN_FAISS_GPU=true

# --- Faiss Product Quantization (IVF-PQ) ---
# Sub-quantizers; 0 = auto (embedding_dim // 8). Must divide dim evenly
TWIN_FAISS_PQ_M=0
# Bits per PQ code (8 = 256 centroids per sub-space)
TWIN_FAISS_PQ_NBITS=8

# --- Faiss HNSW ---
# Graph degree (bi-directional links per node, 4-64)
TWIN_FAISS_HNSW_M=32
# Build-time exploration depth (100-2000)
TWIN_FAISS_HNSW_EF_CONSTRUCTION=200
# Search-time exploration depth (higher = higher recall)
TWIN_FAISS_HNSW_EF_SEARCH=128

# --- Search Funnel ---
# Number of Stage 1 Faiss candidates to recall
TWIN_TOP_K=100
# Rotation invariance: evaluate 0°, 90°, 180°, and 270° orientations
TWIN_ROTATION_INVARIANT=true
# aHash: max Hamming distance for perceptual pre-filter (0-64)
TWIN_AHASH_THRESHOLD=10
# dHash: max Hamming distance for Stage 2 filter (0-64, lower = stricter)
TWIN_DHASH_THRESHOLD=10
# pHash: max Hamming distance for Stage 3 filter (0-64, lower = stricter)
TWIN_PHASH_THRESHOLD=12
# SSIM: min structural similarity for Stage 4 confirmation (0.0 - 1.0)
TWIN_SSIM_THRESHOLD=0.90
# SSIM resize dimension (128 = fast, 256 = precise)
TWIN_SSIM_SIZE=128
# SSIM compute device: auto | cuda | cpu
TWIN_SSIM_DEVICE=auto

# --- Performance & Persistence ---
# Batch size for CLIP/DINOv2 image encoding
TWIN_BATCH_SIZE=64
# Seconds between auto-saves (0 = disable periodic save)
TWIN_AUTO_SAVE_INTERVAL=120
# Auto-sync images dir on startup (blocks until done)
TWIN_SYNC_ON_STARTUP=false

# --- Server ---
TWIN_HOST=0.0.0.0
TWIN_PORT=8000
