# Twin — Image Similarity Search Configuration
# Copy this file to .env and adjust as needed.

# --- Model ---
# CLIP model variant: ViT-B-32, ViT-B-16, ViT-L-14, etc.
TWIN_MODEL_NAME=ViT-B-32
# Pretrained weights: openai, laion2b_s34b_b79k, etc.
TWIN_PRETRAINED=openai
# Device: cuda, mps, cpu, or empty for auto-detect
TWIN_DEVICE=

# --- Faiss ---
# Directory for index files
TWIN_INDEX_PATH=data
# Source images directory (auto-synced on startup)
TWIN_IMAGES_DIR=data/images

# --- Search ---
# Number of Faiss candidates to retrieve
TWIN_TOP_K=50
# dHash: max Hamming distance (0-64, lower = stricter)
TWIN_DHASH_THRESHOLD=10
# pHash: max Hamming distance (0-64, lower = stricter)
TWIN_PHASH_THRESHOLD=12
# SSIM: min structural similarity (0-1, higher = stricter)
TWIN_SSIM_THRESHOLD=0.90

# --- Performance ---
# Images per CLIP forward pass during batch indexing
TWIN_BATCH_SIZE=32
# Seconds between auto-saves (0 = disable periodic save)
TWIN_AUTO_SAVE_INTERVAL=300
